{
    "name": "yako-labs/pdf-to-text",
    "keywords": ["pdf", "poppler", "poppler-utils", "pdftotext"],
    "type": "library",
    "license": "MIT",
    "version": "0.0.1",
    "authors": [
        {
            "name": "yako"
        }
    ],
    "require": {
        "php": "^8.4",
        "symfony/process": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "YakoLabs\\PdfToText\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "pestphp/pest": "^5.3"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
